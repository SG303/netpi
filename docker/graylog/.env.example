# Graylog secrets. Copy to .env and fill in, or let the setup playbook
# (ansible/playbooks/setup_netpi.yml) generate .env for you.
# .env is gitignored and must never be committed.

# Pepper used to encrypt and salt stored passwords. At least 16 characters,
# 64+ recommended. Do NOT change it after the first start, or stored
# credentials (e.g. users, input secrets) can no longer be decrypted.
# Generate: tr -dc 'A-Za-z0-9' </dev/urandom | head -c 96; echo
GRAYLOG_PASSWORD_SECRET=replace-with-at-least-16-random-characters

# SHA256 hash of the password for the built-in "admin" user.
# Generate: echo -n 'your-password' | sha256sum | cut -d' ' -f1
GRAYLOG_ROOT_PASSWORD_SHA2=replace-with-sha256-of-admin-password

# Required by the OpenSearch image (the security plugin is disabled in this
# stack, so it is not used for logins). Must be a strong password.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=replace-with-strong-password
